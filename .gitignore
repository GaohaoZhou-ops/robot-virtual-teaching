# Match ZIP extension case variants, including local renamed archive copies.
*.route.json
virtual-teaching-*.[zZ][iI][pP]
virtual-teaching-*.json
robot-teaching-*.[zZ][iI][pP]
robot-free-navigation-*.json
robot-navigation-*.json
/robot-teaching-*/
*.abxteach.ndjson
/virtual-teaching-*/
parking-merge-server-*.[zZ][iI][pP]
parking-merge-server-*/
parking-merge-*-result.[zZ][iI][pP]
parking-merge-*-result.json
/merge-job/

# Compact regression inputs remain trackable, including export-shaped filenames.
# Keep exceptions after export rules; /**/ covers direct and nested fixture files.
# Reopen exported-project fixture directories so their file exceptions can apply.
!tests/fixtures/**/*.atlas-project/
!tests/fixtures/**/parking-merge-server-*/
!tests/fixtures/**/*.[pP][lL][yY]
!tests/fixtures/**/*.[pP][lL][yY].[gG][zZ]
!tests/fixtures/**/*.atls
!tests/fixtures/**/*.abxteach.ndjson
!tests/fixtures/**/*.json
!tests/fixtures/**/*.[zZ][iI][pP]
