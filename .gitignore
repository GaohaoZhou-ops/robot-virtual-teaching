# Ignore dependencies, generated output, local runtime state, device diagnostics,
# and exported teaching data. Keep source, dependency lockfiles, shared Xcode
# configuration, design artwork, documented environment examples and test fixtures.
# Scope captures and temporary workspaces by path so source assets stay visible.
# Ignoring a path does not delete local data or untrack an existing Git file.
# Inspect a rule with: git check-ignore -v --no-index -- path/to/file

# JavaScript dependencies and package-manager caches
node_modules/
.npm-cache/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

# Build output and frontend tool caches
# build_local.sh writes dist/ and build/local/; the native entry points use
# ipad/build/{device,simulator}/ and vision/build/{device,simulator}/.
# The build/ rule also covers deploy_ipad.sh's ipad/build/deploy-device/ logs,
# device/signing reports, products, and native UI verification attachments.
dist/
build/
out/
output/
.vite/
.vite-temp/
*.tsbuildinfo
vite.config.*.timestamp-*

# Node.js and browser diagnostic dumps
*.heapsnapshot
*.cpuprofile
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
/core
/core.*
*.dmp

# Xcode / Swift build output and local IDE state
# Keep project files, shared schemes, asset catalogs, and source artwork tracked.
DerivedData/
.build/
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.xcarchive/
*.xcarchive.zip
*.app/
*.app.zip
*.xctest/
*.xctest.zip
*.ipa
*.dSYM/
*.dSYM.zip
*.bcsymbolmap

# ZIP copies of Vite output, local build trees and DerivedData, including dated
# snapshots. Match extension case variants; keep source/tool archives and fixtures.
/dist.[zZ][iI][pP]
/dist-*.[zZ][iI][pP]
/build.[zZ][iI][pP]
/build-*.[zZ][iI][pP]
/ipad/build.[zZ][iI][pP]
/ipad/build-*.[zZ][iI][pP]
/vision/build.[zZ][iI][pP]
/vision/build-*.[zZ][iI][pP]
/DerivedData.[zZ][iI][pP]
/DerivedData-*.[zZ][iI][pP]
/ipad/DerivedData.[zZ][iI][pP]
/ipad/DerivedData-*.[zZ][iI][pP]
/vision/DerivedData.[zZ][iI][pP]
/vision/DerivedData-*.[zZ][iI][pP]

